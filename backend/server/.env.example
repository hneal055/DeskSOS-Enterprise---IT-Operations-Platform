NODE_ENV=development
PORT=5100

# Token signing secret (required, at least 32 characters). The server refuses
# to start with the placeholder below: replace it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your-secret-key-change-this-in-production
LOG_LEVEL=debug

# Incidents and users are stored in SQLite (default: backend/server/data/enterprise.db)
# DATABASE_PATH=./data/enterprise.db

# Shared secret the DeskSOS Desktop backend sends as X-API-Key when forwarding
# tickets to POST /api/ingest/incidents. Ingest is disabled while unset.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# INGEST_API_KEY=

# Browser origins allowed to use the API and live socket (comma-separated).
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limits per client IP per 15 minutes
# RATE_LIMIT_API=600      # general API traffic (dashboard polls every 15 s)
# RATE_LIMIT_LOGIN=10     # failed sign-ins per IP + email
# RATE_LIMIT_INGEST=2000  # Desktop bridge intake

# HTTPS: set both or neither (paths relative to backend/server). Production
# requires them; ecosystem.config.js sets ./certs/server.crt and ./certs/server.key.
# Create the certificate with scripts/gen-cert.ps1. Behind a TLS proxy instead,
# set ALLOW_HTTP_IN_PRODUCTION=true.
# TLS_CERT_PATH=./certs/server.crt
# TLS_KEY_PATH=./certs/server.key

# Serve the built dashboard (client/build) from this server on the same port.
# Defaults to true in production, false in development (Vite serves it on :3000).
# SERVE_CLIENT=false
# CLIENT_BUILD_PATH=C:\Projects\DESKSOS\client\build   # absolute; relative paths depend on the working directory

# Sentry error tracking (optional). Set to a Sentry project DSN to be told about
# server errors; leave unset to turn it off. Credentials, API keys and request
# bodies are removed before anything is sent. Check it with: npm run sentry:test
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
